# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# PostgreSQL connection string
# Render Postgres example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/mindyou

# SSL is auto-enabled for Render/cloud URLs.
# Force off for local Postgres:
# DATABASE_SSL=false

# Protects GET /api/export (CSV/JSON download)
# Also used as the password for per-registration ZIP email attachments.
# Use a long random secret in production.
EXPORT_API_KEY=change-me-to-a-long-random-secret

# Optional pool size
# DB_POOL_MAX=10

# SMTP — send a password-protected CSV ZIP to NOTIFY_EMAIL after each registration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Mind You Mental Health <your-smtp-user@gmail.com>"
NOTIFY_EMAIL=mindyou968@gmail.com
